{
  "manifest_version": 3,
  "name": "QuoteHarbor",
  "version": "1.1.0",
  "description": "Capture selected web quotes with their sources and your notes. Search a private research library and export it as Markdown.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuoteHarbor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
