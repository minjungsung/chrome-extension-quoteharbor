{
  "manifest_version": 3,
  "name": "QuoteHarbor: Save Quotes & Sources",
  "version": "1.2.1",
  "description": "Save selected web quotes with source links. Search your local library, add notes and tags, and export Markdown.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuoteHarbor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "short_name": "QuoteHarbor"
}
