{
  "manifest_version": 3,
  "name": "QuoteHarbor",
  "version": "1.2.0",
  "description": "Select a web sentence, open the popup, and save it with its source. Notes and tags are optional; export Markdown later.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "QuoteHarbor"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
